// Prisma Schema for ReunitePath
// Disaster-affected family reunification platform

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

enum Role {
  PUBLIC
  VOLUNTEER
  COORDINATOR
  ADMIN
}

enum Gender {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PriorityFlag {
  NONE
  CHILD_ALONE
  ELDERLY
  CRITICAL_MEDICAL
}

enum ReportStatus {
  REPORTED
  SIGHTED
  LOCATED_AT_CAMP
  VERIFIED_SAFE
}

enum LeadStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MatchPriority {
  NORMAL
  HIGH
  URGENT
}

enum CampStatus {
  OPEN
  NEAR_CAPACITY
  FULL
  EVACUATING
}

enum EventSource {
  DIRECT_REPORT
  EYEWITNESS
  OFFICIAL_ROSTER
  COORDINATOR_VERIFICATION
}

model Disaster {
  id             String          @id @default(uuid())
  name           String
  description    String
  location       String
  state          String?
  latitude       Float           @default(13.0827)
  longitude      Float           @default(80.2707)
  alertLevel     String          @default("RED_ALERT")
  isActive       Boolean         @default(true)
  camps          Camp[]
  persons        Person[]
  missingReports MissingReport[]
  sightings      Sighting[]
  shelterEntries ShelterEntry[]
  leads          Lead[]
  familyGroups   FamilyGroup[]
  safeCheckIns   SafeCheckIn[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Camp {
  id               String         @id @default(uuid())
  disasterId       String
  disaster         Disaster       @relation(fields: [disasterId], references: [id], onDelete: Cascade)
  name             String
  location         String
  latitude         Float
  longitude        Float
  capacity         Int
  currentOccupancy Int            @default(0)
  status           CampStatus     @default(OPEN)
  contactPerson    String
  contactPhone     String
  needs            String         // Comma-separated or JSON list of urgent needs
  shelterEntries   ShelterEntry[]
  users            User[]
  statusEvents     StatusEvent[]
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
}

model User {
  id             String         @id @default(uuid())
  email          String         @unique
  name           String
  passwordHash   String
  role           Role           @default(VOLUNTEER)
  phone          String?
  campId         String?
  camp           Camp?          @relation(fields: [campId], references: [id], onDelete: SetNull)
  intakeEntries  ShelterEntry[] @relation("VolunteerIntake")
  reviewedLeads  Lead[]         @relation("CoordinatorReview")
  auditLogs      AuditLog[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model FamilyGroup {
  id                 String    @id @default(uuid())
  disasterId         String
  disaster           Disaster  @relation(fields: [disasterId], references: [id], onDelete: Cascade)
  token              String    @unique // e.g. "FAM-CYCLONE-8831"
  primaryContactName String
  contactPhone       String
  notes              String?
  members            Person[]
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Person {
  id             String          @id @default(uuid())
  disasterId     String
  disaster       Disaster        @relation(fields: [disasterId], references: [id], onDelete: Cascade)
  fullName       String
  normalizedName String          // Lowercase stripped for fast indexing
  approxAge      Int?
  gender         Gender          @default(UNKNOWN)
  physicalDesc   String?
  medicalNeeds   String?
  priorityFlag   PriorityFlag    @default(NONE)
  photoUrl       String?
  familyGroupId  String?
  familyGroup    FamilyGroup?    @relation(fields: [familyGroupId], references: [id], onDelete: SetNull)
  missingReports MissingReport[]
  sightings      Sighting[]
  shelterEntries ShelterEntry[]
  statusEvents   StatusEvent[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model MissingReport {
  id                   String        @id @default(uuid())
  reportCode           String        @unique // e.g. "MIS-2024-001"
  disasterId           String
  disaster             Disaster      @relation(fields: [disasterId], references: [id], onDelete: Cascade)
  personId             String
  person               Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  reporterName         String
  reporterPhone        String
  reporterRelationship String
  lastSeenLocation     String
  lastSeenDate         DateTime?
  notes                String?
  isConsentGiven       Boolean       @default(true)
  status               ReportStatus  @default(REPORTED)
  leads                Lead[]
  statusEvents         StatusEvent[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
}

model Sighting {
  id               String       @id @default(uuid())
  sightingCode     String       @unique // e.g. "SGT-2024-001"
  disasterId       String
  disaster         Disaster     @relation(fields: [disasterId], references: [id], onDelete: Cascade)
  personId         String?
  person           Person?      @relation(fields: [personId], references: [id], onDelete: SetNull)
  sightedName      String?
  approxAge        Int?
  gender           Gender       @default(UNKNOWN)
  sightingLocation String
  directionHeading String?      // e.g. "Heading towards Loyola College Shelter B"
  groupSize        Int          @default(1)
  additionalPeople String?      // JSON or text list of other people seen together
  witnessName      String
  witnessPhone     String
  notes            String?
  isConsentGiven   Boolean      @default(true)
  leads            Lead[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model ShelterEntry {
  id                String       @id @default(uuid())
  entryCode         String       @unique // e.g. "SHL-2024-001"
  disasterId        String
  disaster          Disaster     @relation(fields: [disasterId], references: [id], onDelete: Cascade)
  campId            String
  camp              Camp         @relation(fields: [campId], references: [id], onDelete: Cascade)
  personId          String
  person            Person       @relation(fields: [personId], references: [id], onDelete: Cascade)
  intakeVolunteerId String?
  intakeVolunteer   User?        @relation("VolunteerIntake", fields: [intakeVolunteerId], references: [id], onDelete: SetNull)
  arrivalDate       DateTime     @default(now())
  status            String       @default("IN_SHELTER") // IN_SHELTER, TRANSFERRED, REUNITED
  groupNotes        String?
  isConsentGiven    Boolean      @default(true)
  leads             Lead[]
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
}

model Lead {
  id              String        @id @default(uuid())
  disasterId      String
  disaster        Disaster      @relation(fields: [disasterId], references: [id], onDelete: Cascade)
  missingReportId String
  missingReport   MissingReport @relation(fields: [missingReportId], references: [id], onDelete: Cascade)
  sightingId      String?
  sighting        Sighting?     @relation(fields: [sightingId], references: [id], onDelete: SetNull)
  shelterEntryId  String?
  shelterEntry    ShelterEntry? @relation(fields: [shelterEntryId], references: [id], onDelete: SetNull)
  confidenceScore Int           // 0 - 100
  matchReason     String        // Short summary
  explanation     String        // Plain language: "Why we think this"
  isFallback      Boolean       @default(false) // e.g. sighting heading to shelter B
  status          LeadStatus    @default(PENDING)
  priority        MatchPriority @default(NORMAL)
  reviewedById    String?
  reviewedBy      User?         @relation("CoordinatorReview", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewNotes     String?
  reviewedAt      DateTime?
  retractedAt     DateTime?
  retractionReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
}

model StatusEvent {
  id               String        @id @default(uuid())
  personId         String
  person           Person        @relation(fields: [personId], references: [id], onDelete: Cascade)
  missingReportId  String?
  missingReport    MissingReport? @relation(fields: [missingReportId], references: [id], onDelete: Cascade)
  status           ReportStatus
  source           EventSource
  location         String
  notes            String
  verifiedByCampId String?
  verifiedByCamp   Camp?         @relation(fields: [verifiedByCampId], references: [id], onDelete: SetNull)
  createdAt        DateTime      @default(now())
}

model SafeCheckIn {
  id              String    @id @default(uuid())
  disasterId      String
  disaster        Disaster  @relation(fields: [disasterId], references: [id], onDelete: Cascade)
  fullName        String
  phone           String
  currentLocation String
  message         String?
  isNotified      Boolean   @default(false)
  createdAt       DateTime  @default(now())
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String   // e.g. "LEAD_APPROVED", "LEAD_REJECTED", "LEAD_RETRACTED", "ROSTER_MERGED"
  entityType String   // "Lead", "Person", "ShelterEntry", "Camp"
  entityId   String
  details    String   // JSON or descriptive text
  createdAt  DateTime @default(now())
}
